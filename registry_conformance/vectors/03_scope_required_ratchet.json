  {
   "id": "RT-05-restore-cannot-clear-ratchet",
   "title": "Restoring a store from before the ratchet was set fails closed and keeps the ratchet set",
   "cites": [
    "contract 7.3 restore cannot clear it",
    "contract 8.3"
   ],
   "scopes": {
    "A": {
     "selection_id": "sel-a"
    }
   },
   "steps": [
    {
     "op": "advance",
     "obs": {
      "kind": "select",
      "scope": "A",
      "epoch": 1,
      "selection_digest": "sha256:aa4aadbdb3913d8d1b3fe4329dc64ee059c492453b5562a5adfb750f0a776624"
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "activated"
     }
    },
    {
     "op": "save",
     "name": "before"
    },
    {
     "op": "advance",
     "obs": {
      "kind": "select",
      "scope": "A",
      "epoch": 2,
      "selection_digest": "sha256:0e645890f4ed1deefeb6492f411e07cc09196a1f134d9541842e70d4ea2914f4",
      "supersedes": {
       "selection_id": "sel-a",
       "epoch": 1,
       "statement_digest": "sha256:aa4aadbdb3913d8d1b3fe4329dc64ee059c492453b5562a5adfb750f0a776624"
      },
      "participation": "required"
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "activated"
     }
    },
    {
     "op": "advance",
     "obs": {
      "kind": "restore",
      "backup": {
       "$saved": "before"
      }
     },
     "expect": {
      "verdict": "UNKNOWN_FAIL_CLOSED",
      "code": "state_older_than_anchor"
     }
    },
    {
     "op": "check",
     "expect": {
      "store": "unknown",
      "scope_required": [
       "A"
      ]
     }
    },
    {
     "op": "policy_state",
     "scope": "A",
     "now": 300,
     "expect": {
      "policy_state": "unknown",
      "display": "REQUIRED \u2014 UNAVAILABLE"
     }
    }
   ]
  },
