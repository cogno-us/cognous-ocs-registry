  {
   "id": "RT-01-optional-select-cannot-downgrade",
   "title": "Once a required selection activates the ratchet is set; an optional select refuses participation_mismatch",
   "cites": [
    "ADR D-06",
    "contract 7.3",
    "R1/A4"
   ],
   "scopes": {
    "A": {
     "selection_id": "sel-a"
    }
   },
   "steps": [
    {
     "op": "advance",
     "obs": {
      "kind": "select",
      "scope": "A",
      "epoch": 1,
      "selection_digest": "sha256:aa4aadbdb3913d8d1b3fe4329dc64ee059c492453b5562a5adfb750f0a776624",
      "participation": "required"
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "activated"
     }
    },
    {
     "op": "check",
     "expect": {
      "scope_required": [
       "A"
      ]
     }
    },
    {
     "op": "advance",
     "obs": {
      "kind": "select",
      "scope": "A",
      "epoch": 2,
      "selection_digest": "sha256:0e645890f4ed1deefeb6492f411e07cc09196a1f134d9541842e70d4ea2914f4",
      "supersedes": {
       "selection_id": "sel-a",
       "epoch": 1,
       "statement_digest": "sha256:aa4aadbdb3913d8d1b3fe4329dc64ee059c492453b5562a5adfb750f0a776624"
      }
     },
     "expect": {
      "verdict": "REFUSE",
      "code": "participation_mismatch"
     }
    },
    {
     "op": "check",
     "expect": {
      "scope_required": [
       "A"
      ],
      "high_water": {
       "A": 1
      },
      "evidence_count": 1
     }
    }
   ]
  },
