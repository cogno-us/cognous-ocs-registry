  {
   "id": "RC-01-restart-state-intact",
   "title": "Restart with state intact: the persisted value reads back consistent and unchanged",
   "cites": [
    "contract 8.5",
    "DT-04"
   ],
   "scopes": {
    "A": {
     "selection_id": "sel-a"
    }
   },
   "steps": [
    {
     "op": "advance",
     "obs": {
      "kind": "select",
      "scope": "A",
      "epoch": 1,
      "selection_digest": "sha256:aa4aadbdb3913d8d1b3fe4329dc64ee059c492453b5562a5adfb750f0a776624"
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "activated"
     }
    },
    {
     "op": "advance",
     "obs": {
      "kind": "sync",
      "snapshot": {
       "version": 1,
       "fingerprint": "sha256:9f2460b56367bc4e5050aec0c5fb6c516f06dc5e924e14a89d52d47ee2911b80",
       "valid_until": 5000,
       "revoked_selections": [],
       "revoked_key_ids": [],
       "min_epochs": []
      }
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "synced"
     }
    },
    {
     "op": "save",
     "name": "persisted"
    },
    {
     "op": "swap_to",
     "name": "persisted"
    },
    {
     "op": "advance",
     "obs": {
      "kind": "read"
     },
     "expect": {
      "verdict": "ACCEPT",
      "code": "state_consistent"
     }
    },
    {
     "op": "policy_state",
     "scope": "A",
     "now": 300,
     "expect": {
      "policy_state": "active",
      "display": "ENABLED"
     }
    },
    {
     "op": "check",
     "expect": {
      "store": "known",
      "log_length": 2
     }
    }
   ]
  },
