  {
   "id": "PS-01-not-selected-and-selected-not-activated",
   "title": "No row: not_selected; a known but unactivated selection: selected_not_activated",
   "cites": [
    "contract 7.2",
    "ADR D-05"
   ],
   "scopes": {
    "A": {
     "selection_id": "sel-a"
    }
   },
   "steps": [
    {
     "op": "policy_state",
     "scope": "A",
     "now": 300,
     "expect": {
      "policy_state": "not_selected",
      "display": "DISABLED"
     }
    },
    {
     "op": "policy_state",
     "scope": "A",
     "now": 300,
     "expect": {
      "policy_state": "selected_not_activated",
      "display": "selected_not_activated"
     },
     "known_selection": {
      "selection_id": "sel-a",
      "epoch": 1
     }
    }
   ]
  },
