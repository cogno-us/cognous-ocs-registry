  "limitation_cases": [
    {
      "id": "LIM-1",
      "description": "Loaded-code tampering is not detected: after the consumer verified the on-disk source, the loaded LocalExecutionPolicy.check is replaced by a permissive function in-process, and the overlay still reports ACCEPT. Documented trust limitation (compromised interpreter or process), not a defect and not a protected case.",
      "expected": {
        "disposition": "ACCEPT"
      },
      "classification": "documented_limitation"
    },
    {
      "id": "LIM-2",
      "description": "S03 alone does not authenticate: a widened, re-digested record is accepted by the S03 validator; only the S04 pin and file hash refuse it.",
      "expected": {
        "s03_outcome": "ACCEPT",
        "consumer_reason": "record_file_mismatch"
      },
      "classification": "documented_limitation"
    },
    {
      "id": "LIM-3",
      "description": "record_source in the manifest is unverified provenance: a manifest whose record_source.commit is any 40-hex value still ACCEPTs when everything else verifies.",
      "expected": {
        "disposition": "ACCEPT"
      },
      "classification": "documented_limitation"
    }
  ]
