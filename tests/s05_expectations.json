  },
  "grids": {
    "G1": {
      "description": "exhaustive: 2 universe values per field, caller subsets incl. empty (64), registry non-empty subsets (27), operations over universe+outside values (27)",
      "caller_policies": 64,
      "registry_records": 27,
      "operations": 27,
      "pairs": 1728,
      "comparisons": 46656
    },
    "G2": {
      "description": "per-field exhaustive: 3 universe values, caller subsets (8) x registry non-empty subsets (7), 4 operations, other fields fully allowing; run for each of the three fields",
      "pairs_per_field": 56,
      "operations_per_field": 4,
      "fields": 3,
      "comparisons": 672
    }
  },
  "rules": {
    "A_equivalence": "for every grid pair and operation, registry-backed outcome == direct historical policy built with the oracle's effective sets == oracle outcome",
    "B_non_widening": "for every grid pair and operation, if the caller-constructed historical policy refuses, the registry-backed policy refuses; admitted(registry-backed) is a subset of admitted(caller)",
    "C_refusal": "every refusal case yields the expected disposition and reason, result.policy is the caller's object, overlay_applied is false, the caller's fields are unchanged, and the policy's behavior over all G1 operations equals the oracle for the caller's own sets",
    "D_boundary": "empty intersections deny; first failing check in fixed order decides the reason",
    "E_representation": "each unsupported class is refused by S03 with record_invalid and by the consumer as record_refused; under refusal the caller policy governs (behavior equals historical); where the caller lists an unsupported value and a representable record is applied, the removed value is designed narrowing, not inequivalence"
  },
